{
  "ci": {
    "collect": { "startServerCommand": "pnpm dev", "url": ["http://localhost:3000/", "http://localhost:3000/alertes"], "numberOfRuns": 1 },
    "assert": { "preset": "lighthouse:recommended", "assertions": { "categories:performance": ["warn", { "minScore": 0.8 }], "categories:accessibility": ["error", { "minScore": 0.9 }], "categories:seo": ["error", { "minScore": 0.9 }] } }
  }
}
